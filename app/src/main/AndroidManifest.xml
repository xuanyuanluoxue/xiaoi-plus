<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:versionCode="22"
    android:versionName="0.15.0">

    <!-- miuix-blur 的 AAR 声明 minSdk 33；本项目 minSdk 26，玻璃效果只在
         API 33+ 调用，低版本走实心回退（GlassSupport）。override 只放开清单合并，
         不改变 minSdk。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- App 内闹钟：API 31+ 精确闹钟；未授权时 agent 会退化为非精确并如实返回 exact=false。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 首页「电池优化」直接拉起本 App 的白名单对话框；否则只能跳到列表页，
         用户经常在里面找不到本 App。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- minSdk 26 / targetSdk 34 由 app/build.gradle.kts 声明（AGP 9 禁止在 Manifest
         写 uses-sdk）。targetSdk 34 用于开启预测性返回；未升 35，避免强制
         edge-to-edge 影响状态栏/底栏。 -->

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.XiaoiPlus"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="小爱同学plus：模型重定向 / 输出标记 / 能力桥（仅本机）" />
        <meta-data android:name="xposedminversion" android:value="93" />

        <!-- 0.14 起 Compose 单 Activity 是唯一启动入口；旧首页只从兼容模式显式打开。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.XiaoiPlus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.XiaoiPlus" />
        <activity android:name=".ConfigActivity" android:exported="false" android:theme="@style/Theme.XiaoiPlus" />
        <activity android:name=".LogsActivity" android:exported="false" android:theme="@style/Theme.XiaoiPlus" />
        <activity android:name=".AboutActivity" android:exported="false" android:theme="@style/Theme.XiaoiPlus" />

        <!-- P0 spike：仅验证 Compose + Miuix 可构建/可渲染；不是启动入口。 -->
        <activity
            android:name=".ui.spike.SpikeActivity"
            android:exported="false"
            android:theme="@style/Theme.XiaoiPlus" />

        <!-- WP1 控制面：显式 ComponentName + exported，供 com.miui.voiceassist
             通过 Binder 拉配置/注册回调。无 intent-filter；安全边界在每个
             transaction 首行的 UID 校验（见 BridgeControlBinder）。 -->
        <service
            android:name=".control.BridgeControlService"
            android:exported="true"
            android:enabled="true" />

        <!-- WP1.2a：App 进程内的 Agent 动作面（127.0.0.1:8770）。
             exported=false：只允许本 App 启动，外部只能走 HTTP + Bearer。 -->
        <service
            android:name=".agent.AgentService"
            android:exported="false"
            android:enabled="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="本机 Agent 动作面（loopback 8770），用于设备信息与后续动作" />
        </service>

        <!-- 开机自启：是否监听由 AgentService 按 mcpEnabled + token 判断。 -->
        <receiver
            android:name=".agent.AgentBootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- App 内闹钟：AlarmManager 的 PendingIntent 显式指向本 Receiver，不导出。 -->
        <receiver
            android:name=".agent.AgentAlarmReceiver"
            android:exported="false"
            android:enabled="true" />

        <provider
            android:name=".ShareProvider"
            android:authorities="plus.xiaoi.module.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
