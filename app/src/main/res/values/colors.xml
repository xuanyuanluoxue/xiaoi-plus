<?xml version="1.0" encoding="utf-8"?>
<!-- 说明：build.sh 以 aapt2 link -R 传入资源（overlay 模式），新增的 values 资源需 add-resource 声明，否则报 “does not override an existing resource”。

     颜色令牌只保留一套语义名（18 个）。旧别名 card / input_bg / divider / hairline /
     surface / hero_* / nav_bg / pressed 等已删除，引用处统一改为下面的名字。
     Shizuku 风格：近白灰底 + 浅灰卡片 + 深蓝强调。 -->
<resources>
    <add-resource type="color" name="bg" />
    <add-resource type="color" name="surface" />
    <add-resource type="color" name="surface_2" />
    <add-resource type="color" name="line" />
    <add-resource type="color" name="text" />
    <add-resource type="color" name="text_secondary" />
    <add-resource type="color" name="text_hint" />
    <add-resource type="color" name="primary" />
    <add-resource type="color" name="primary_pressed" />
    <add-resource type="color" name="on_primary" />
    <add-resource type="color" name="chip_bg" />
    <add-resource type="color" name="chip_bg_pressed" />
    <add-resource type="color" name="chip_ok_bg" />
    <add-resource type="color" name="success" />
    <add-resource type="color" name="warning" />
    <add-resource type="color" name="warning_bg" />
    <add-resource type="color" name="error" />
    <add-resource type="color" name="error_bg" />
    <add-resource type="color" name="icon_tile" />

    <color name="bg">#F7F8FA</color>
    <color name="surface">#F1F2F5</color>
    <color name="surface_2">#FFFFFF</color>
    <color name="line">#E6E9EE</color>

    <color name="primary">#2F4A6B</color>
    <color name="primary_pressed">#263D59</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="chip_bg">#E4EBF3</color>
    <color name="chip_bg_pressed">#D6E0EC</color>
    <color name="chip_ok_bg">#DCE9F7</color>

    <color name="success">#2E7D5B</color>
    <color name="warning">#B26A00</color>
    <color name="warning_bg">#FFF3D6</color>
    <color name="error">#C43D3D</color>
    <color name="error_bg">#1AC43D3D</color>

    <color name="text">#111318</color>
    <color name="text_secondary">#7A828E</color>
    <color name="text_hint">#9AA1AC</color>
    <color name="icon_tile">#DCE9F7</color>
</resources>
