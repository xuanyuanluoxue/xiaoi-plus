.gradle/
build/
tests/.build/
local.properties
*.iml
.idea/
.kotlin/
*.jks
*.keystore
app/release/
build/
.gradle/
*.keystore

# 本项目内的产物/临时/凭据（0.16.0 起不在项目外写文件）
artifacts/
tmp/
.secrets/
.worktrees/

# AOCI agent host integration (machine-bound; do not commit)
# 官方要求：init 写出的 .mcp.json / .codex/config.toml / opencode.json 含绝对路径，
# 入库后在别的机器上必坏，且 init 按 key 存在判断会静默保留坏路径。
opencode.json
opencode.json.backup.*
.mcp.json
.mcp.json.backup.*
.codex/config.toml
.cursor/mcp.json

# 构建产物与发布归档（二进制进 Release，不进源码仓）
dist/

# AOCI 认知索引：按工具设计提交进仓库；.aoci/ 自身用 .aoci/.gitignore 白名单
# （baseline/config/curation 入库，ledger 等运行时产物不入库）
# aoci 每次改 AGENTS.md 都会留一份同内容备份，不要入库
AGENTS.md.backup.*

# 运行/发布敏感产物（开源仓不收录）
logs/
*.log
*.apk
*.sha256
*.idsig
# 例外：发布门禁固定签名指纹（证书公钥指纹，不是产物校验和）
!scripts/expected-signer.sha256
kpass.txt
*.p12
*.pfx
keystore/
.env
