{"jsonrpc":"2.0","id":3,"result":{"tools":[{"name":"xiaoai_status","description":"探活：返回小爱进程内 facade/CLI 是否就绪，以及桥的监听端口。","inputSchema":{"type":"object","properties":{},"additionalProperties":false}},{"name":"xiaoai_submit","description":"让小爱（手机端语音助手）执行一句话任务，返回它的回复文本。不传 sessionId 时自动开新会话。","inputSchema":{"type":"object","properties":{"text":{"type":"string","description":"要说给小爱的话"},"sessionId":{"type":"string","description":"可选；复用已有会话以获得上下文"}},"required":["text"],"additionalProperties":false}},{"name":"xiaoai_cli","description":"原始 CLI：传入 {\"id\",\"method\",\"params\"} 的 JSON 字符串，直接走小爱 CliDispatcher 并返回原始响应。","inputSchema":{"type":"object","properties":{"cmd":{"type":"string","description":"JSON 命令串，例如 {\"id\":\"1\",\"method\":\"auth.status\"}"}},"required":["cmd"],"additionalProperties":false}},{"name":"xiaoai_config","description":"读取当前生效配置（model / baseUrl / marker / bridge / token 是否已设置）。","inputSchema":{"type":"object","properties":{},"additionalProperties":false}},{"name":"xiaoai_island","description":"手动触发一次超级岛提示（单次，6 秒后自动消失），用于验证岛通路。","inputSchema":{"type":"object","properties":{"text":{"type":"string","description":"可选；提示文案，默认显示当前模型"},"force":{"type":"boolean","description":"是否忽略单次限制（调试用，默认 true）"}},"additionalProperties":false}},{"name":"xiaoai_switch_model","description":"热切换模型：只传 model 即可复用现有端点与 key；也可一并改 baseUrl/apiKey。写入 prefs 后全进程 1 秒内生效，无需重启小爱，也无需打开模块设置页。","inputSchema":{"type":"object","properties":{"model":{"type":"string","description":"上游 model id，例如 deepseek-chat"},"baseUrl":{"type":"string","description":"可选；OpenAI 兼容 base URL"},"apiKey":{"type":"string","description":"可选；不传则保留现有 key"},"marker":{"type":"boolean","description":"可选；回复开头是否带 [model=...]"},"bridge":{"type":"boolean","description":"可选；是否保留能力桥"}},"required":["model"],"additionalProperties":false}},{"name":"xiaoai_logs","description":"读取模块运行日志（最近 300 条环形缓冲，落盘在 files/xiaoi_plus.log）。","inputSchema":{"type":"object","properties":{"limit":{"type":"integer","description":"返回尾部多少条，默认 80"},"since":{"type":"integer","description":"只返回 seq 大于该值的日志"}},"additionalProperties":false}},{"name":"xiaoai_stats","description":"调用量统计：按天返回三方 / 官方模型的调用次数。默认只算主对话（请求含 tools 或消息数 ≥6），记忆抽取等子调用单独记在 sub 里。","inputSchema":{"type":"object","properties":{"days":{"type":"integer","description":"统计最近多少天，默认 7，范围 1~90"}},"additionalProperties":false}}]}}